          "text": [
            "Enter an integer 0-100. Type done if finished.8\n",
            "Enter an integer 0-100. Type done if finished.done\n",
            "count: 1.00, sum: 8.00, min: 8.00, max: 8.00, mean: 8.00\n"
          ]
        }
