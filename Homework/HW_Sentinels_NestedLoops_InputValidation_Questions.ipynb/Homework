      "source": [
        "def stats():\n",
        "#initializing variables\n",
        "    count = 0\n",
        "    sum = 0\n",
        "\n",
        "    list = []\n",
        "\n",
        "    while True:\n",
        "        integers = input(\"Enter an integer 0-100. Type done if finished.\").strip().lower() #Input\n",
        "        if integers == 'done':\n",
        "            break\n",
        "        elif integers == '':\n",
        "            continue\n",
        "        else:\n",
        "            try: # If valid input, then validate\n",
        "                integers = int(integers)\n",
        "                if integers < 0 or integers > 100:\n",
        "                    raise ValueError(\"Please enter an integer 0-100, not {integer}\")\n",
        "            except:\n",
        "                print(f\"Please enter an integer, not {integers}\")\n",
        "                continue\n",
        "        if integers >= 0 and integers <= 100:\n",
        "            count += 1 #add 1 to count\n",
        "            sum += integers #add next integer to total sum\n",
        "            list.append(integers) #add number to list(so can get min/max from list)\n",
        "            mean = sum/count #calculate average\n",
        "            minimum = min(list)\n",
        "            maximum = max(list)\n",
        "    if count == 0: # if 'done' before any data entered\n",
        "      print(\"No data\")\n",
        "    else:\n",
        "      print(f\"count: {count:.2f}, sum: {sum:.2f}, min: {minimum:.2f}, max: {maximum:.2f}, mean: {mean:.2f}\")\n",
        "stats()"
      ]
