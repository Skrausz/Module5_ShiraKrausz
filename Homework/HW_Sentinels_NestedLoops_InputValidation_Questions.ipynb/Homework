        "\n",
        "while True: #loop so can run until stopped\n",
        "  k = 0 #no vowels(k) before input\n",
        "  word = input(\"Input a word. Type done to exit: \")\n",
        "  if word == 'done':\n",
        "    break\n",
        "  else:\n",
        "    for ch in word:#for loop so can test each letter in word\n",
        "      if ch.lower() == 'a' or ch.lower() == 'e' or ch.lower() == 'i' or ch.lower() == 'o' or ch.lower() == 'u': #if any letters are a vowel:\n",
        "        k += 1 #add 1 to vowel count\n",
        "  print(f\"{word} has {k} vowel(s)\")\n"
