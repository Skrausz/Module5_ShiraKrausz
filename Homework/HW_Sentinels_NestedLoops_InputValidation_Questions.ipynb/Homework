        "def get_choice(prompt, options): #defining function\n",
        "\n",
        " colors = input(prompt)\n",
        " end = 0 # initializing variable\n",
        "\n",
        " while end != 1: # if end is changed to 1, loop will end\n",
        "  colors_lower = colors.lower().strip()\n",
        "  for index in options: #go through options in list\n",
        "\n",
        "    if index == colors_lower: #if a guess matches any in list...\n",
        "\n",
        "     end = 1 #change end, which will end while loop\n",
        "     break #break out of forloop, so stops anylizing more colors\n",
        "  else:\n",
        "    colors = input(\"Pick a new color\") #if color didn't match any listed, get new input\n",
        "\n",
        "\n",
        "\n",
        "\n",
        " print(f\"You chose{colors}\")\n",
        "get_choice(\"Pick a color\", [\"red\",\"blue\",\"green\"]) #defining promt, options"
